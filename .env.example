DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
JATEVO_API_KEY=
JATEVO_BASE_URL=
LLM_PROVIDER=deepseek
EMBED_MODEL=nomic-embed-text
EMBED_DIM=768
# For bge-m3 migration (Phase 4.4): EMBED_MODEL=bge-m3 and EMBED_DIM=1024
OLLAMA_BASE_URL=http://localhost:11434
# Reranker: flashrank (fast, default) | bge (bge-reranker-v2-m3, accurate) | none
RERANKER=flashrank
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL=40
# PDF rename (Phase 14). Pattern fields: {authors} {year} {title}
RENAME_PATTERN={authors} ({year}) - {title}
CROSSREF_ENABLED=true
WATCH_FOLDERS=
DB_PATH=data/library.db
VPS_USER=
VPS_HOST=
VPS_PATH=
VPS_SSH_PORT=22
