DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
JATEVO_API_KEY=
JATEVO_BASE_URL=
LLM_PROVIDER=deepseek
EMBED_MODEL=bge-m3
EMBED_DIM=1024
# Extractor: docling (reading order, tables, OCR) | pymupdf (fast). OCR slows docling.
EXTRACTOR=docling
OCR=false
# Default is bge-m3 (1024-d). Alternative: EMBED_MODEL=nomic-embed-text and EMBED_DIM=768
OLLAMA_BASE_URL=http://localhost:11434
# Reranker: flashrank (fast, default) | bge (bge-reranker-v2-m3, accurate) | none
RERANKER=flashrank
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_POOL=40
# PDF rename (Phase 14). Pattern fields: {authors} {year} {title}
RENAME_PATTERN={authors} ({year}) - {title}
CROSSREF_ENABLED=true
WATCH_FOLDERS=
# Base dir untuk folder per-proyek (auto-ingest + auto-link saat watcher jalan)
PROJECTS_DIR=~/Documents/library-eka
DB_PATH=data/library.db
VPS_USER=
VPS_HOST=
VPS_PATH=
VPS_SSH_PORT=22
# Runtime-selectable generation models (admin ⚙ menu): provider[:model], comma-separated
LLM_CHOICES=deepseek,jatevo
